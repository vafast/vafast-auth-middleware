{
  "name": "@vafast/auth-middleware",
  "version": "0.1.9",
  "description": "Authentication middleware for Vafast - Generic JWT/API Key verification with dependency injection",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "keywords": [
    "vafast",
    "auth",
    "middleware",
    "jwt",
    "api-key",
    "authentication"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "npx vitest run",
    "release": "npm run build && npm run test && npx bumpp && npm publish --access=public"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsdown": "^0.19.0-beta.4",
    "typescript": "^5.4.5",
    "vafast": "^0.5.1",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "vafast": "^0.5.1"
  }
}